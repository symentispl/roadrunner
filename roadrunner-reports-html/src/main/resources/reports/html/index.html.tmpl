<!DOCTYPE html>
<html>
<head>
    <title>Roadrunner Performance Results</title>
    <script src="data.js"/></script>
    <script src="users.js"/></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
<div style="border: 1px solid #ccc; padding: 20px; margin: 20px auto; width: 80%; font-family: 'Arial', sans-serif; background-color: #f9f9f9; border-radius: 4px;">
    <h2>Summary</h2>
    <table style="width: 15%; border-collapse: collapse;">
        <tr>
            <td style="padding: 8px; font-weight: bold;">Max:</td>
            <td style="padding: 8px;">${max}ms</td>
        </tr>
        <tr>
            <td style="padding: 8px; font-weight: bold;">Min:</td>
            <td style="padding: 8px;">${min}ms</td>
        </tr>
        <tr>
            <td style="padding: 8px; font-weight: bold;">Mean:</td>
            <td style="padding: 8px;">${mean}ms</td>
        </tr>
    </table>
</div>
<div style="width: 80%; margin: auto;">
    <canvas id="performanceChart"></canvas>
</div>
<script>

    const ctx = document.getElementById('performanceChart');

    new Chart(ctx, {
        type: 'line',
        data: {
            datasets: [{
                label: 'p50',
                data: datapoints.p50,
                borderColor: 'rgba(54, 162, 235, 1)',
                yAxisID: 'y'
            }, {
                label: 'p90',
                data: datapoints.p90,
                borderColor: 'rgba(255, 159, 64, 1)',
                yAxisID: 'y'
            }, {
                label: 'p99',
                data: datapoints.p99,
                borderColor: 'rgba(255, 99, 132, 1)',
                yAxisID: 'y'
            }, {
                label: 'Number of Users',
                data: users,
                borderColor: 'rgba(75, 192, 192, 1)',
                yAxisID: 'y1'
            }]
        },
        options: {
            responsive: true,
            scales: {
                x: {
                    type: 'linear',
                    position: 'bottom',
                    title: {
                        display: true,
                        text: 'Elapsed time (s)'
                    }
                },
                y: {
                    title: {
                        display: true,
                        text: 'Execution Time (ms)'
                    }
                },
                y1: {
                    position: 'right',
                    title: {
                        display: true,
                        text: 'Number of Users'
                    }
                }
            },
            plugins: {
                title: {
                    display: true,
                    text: 'Latency Percentiles and User Count Over Time'
                }
            }
        }
    });

</script>
</body>
</html>